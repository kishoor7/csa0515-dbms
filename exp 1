
-- EXPERIMENT 1: DDL COMMANDS
-- CREATE, ALTER, TRUNCATE, DROP

CREATE DATABASE IF NOT EXISTS dbms_lab;
USE dbms_lab;

-- QUESTION 1: CREATE STUDENT TABLE

CREATE TABLE STUDENT (
    RegNo INT,
    Name VARCHAR(15),
    Gender CHAR(1),
    DOB DATE,
    MobileNo BIGINT,
    City VARCHAR(15)
);

DESC STUDENT;

-- QUESTION 2: CREATE FACULTY TABLE

CREATE TABLE FACULTY (
    FacNo VARCHAR(4),
    FacName VARCHAR(15),
    Gender CHAR(1),
    DOB DATE,
    DOJ DATE,
    MobileNo BIGINT
);

DESC FACULTY;

-- QUESTION 3: CREATE DEPARTMENT TABLE

CREATE TABLE DEPARTMENT (
    DeptNo VARCHAR(4),
    DeptName VARCHAR(15),
    DeptHead VARCHAR(4)
);

DESC DEPARTMENT;

-- QUESTION 4: CREATE COURSE TABLE

CREATE TABLE COURSE (
    CourseNo VARCHAR(3),
    CourseDesc VARCHAR(14),
    CourseType CHAR(1),
    SemNo CHAR(1),
    HallNo VARCHAR(4),
    FacNo VARCHAR(4)
);

DESC COURSE;

-- QUESTION 5: ALTER FACULTY TABLE

ALTER TABLE FACULTY
ADD Dept VARCHAR(10);

DESC FACULTY;

-- DEMONSTRATION OF TRUNCATE AND DROP

CREATE TABLE TEST (
    ID INT,
    Name VARCHAR(20)
);

INSERT INTO TEST VALUES (1, 'RAM');

TRUNCATE TABLE TEST;

DROP TABLE TEST;

-- DISPLAY ALL TABLES

SHOW TABLES;

