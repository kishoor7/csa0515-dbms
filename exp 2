
-- EXPERIMENT 2: DDL COMMANDS WITH CONSTRAINTS

CREATE DATABASE IF NOT EXISTS dbms_lab;
USE dbms_lab;

-- QUESTION 1: PRIMARY KEY ON STUDENT2

CREATE TABLE STUDENT2 (
    RegNo INT,
    S1Name VARCHAR(15),
    Age CHAR(2),
    MobileNo BIGINT,
    Address VARCHAR(15)
);

ALTER TABLE STUDENT2
ADD PRIMARY KEY (RegNo);

DESC STUDENT2;


-- QUESTION 2: FACULTY CONSTRAINTS

ALTER TABLE FACULTY
ADD PRIMARY KEY (FacNo);

ALTER TABLE FACULTY
ADD CONSTRAINT chk_gender
CHECK (Gender IN ('M', 'F'));

DESC FACULTY;
SHOW CREATE TABLE FACULTY;


-- QUESTION 3: DEPARTMENT PRIMARY KEY

ALTER TABLE DEPARTMENT
ADD PRIMARY KEY (DeptNo);

DESC DEPARTMENT;


-- QUESTION 4: COURSE CONSTRAINTS

ALTER TABLE COURSE
ADD PRIMARY KEY (CourseNo);

ALTER TABLE COURSE
ADD CONSTRAINT chk_sem
CHECK (SemNo BETWEEN '1' AND '6');

DESC COURSE;
SHOW CREATE TABLE COURSE;


-- QUESTION 5: UNIQUE KEY ON STUDENT2

ALTER TABLE STUDENT2
ADD UNIQUE KEY (S1Name);

DESC STUDENT2;


-- QUESTION 6: FOREIGN KEY CONSTRAINT

CREATE TABLE STUDENT3 (
    RegNo INT,
    StudentName VARCHAR(15)
);

ALTER TABLE STUDENT3
ADD CONSTRAINT fk_regno
FOREIGN KEY (RegNo)
REFERENCES STUDENT2(RegNo);

DESC STUDENT3;
SHOW CREATE TABLE STUDENT3;
